38;5;198;48;5;16m{\u001b[0m\u001b[38;5;81;48;5;235mcount\u001b[0m\u001b[38;5;198;48;5;16m}\u001b[0m\u001b[48;5;235m                                                                                \u001b[0m\r\n\u001b[48;5;235m                                                                                              \u001b[0m\r\n\r\n\u001b[2mExample:\u001b[0m kq run examples.sample MyTable \u001b[1;36m5\u001b[0m\r\n"]
